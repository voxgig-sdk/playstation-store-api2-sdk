
main: kit: feature: test: {

  name: key()
  title: "Test transport"
  description: "In-memory mock transport for testing without a live server"
  version: '0.0.1'
  active: true
  base: 'node_modules/@voxgig/sdkgen/project/.sdk'
  package: '@voxgig/sdkgen'
  transport: 'base'

  config: {
    # Test mode is not active by default, unlike most features
    options: active: false
  }

  hook: {
    PostConstruct: active: true
    PostConstructEntity: active: true
    SetData: active: true
    GetData: active: true
    SetMatch: active: true
    GetMatch: active: true

    PrePoint: active: true
    PreSpec: active: true
    PreRequest: active: true
    PreResponse: active: true
    PreResult: active: true
  }
}


main: kit: feature: test: config: optspec: {
  # seeded records, keyed by entity name
  entity: '`$MAP`'
  # netsim-shaped conditions for the mock transport
  net: '`$MAP`'
}
