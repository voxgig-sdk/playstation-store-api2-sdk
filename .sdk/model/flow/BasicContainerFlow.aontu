# BasicContainerFlow

main: kit: flow: BasicContainerFlow:
{
  entity: "container",
  kind: "basic",
  name: "BasicContainerFlow",
  step: [
    {
      input: {
        ref: "container_ref01",
        srcdatavar: "container_ref01_data",
        suffix: "_dt0"
      }

      match: {
        age_limit: "age_limit01",
        country: "country01",
        id: "container01",
        language: "language01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-container_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicContainerFlow"
}