
main: kit: target: php: {

  title: PHP
  ext: php
  comment: line: "//"
  module: name: 'playstation-store-api2'
  base: 'node_modules/@voxgig/sdkgen/project/.sdk'
  package: '@voxgig/sdkgen'
  srcfeature: false

  # Applicability (docs/design/feature-tags.md). A vendored sekreto port
  # lives in this target's feature container (tm/php/feature/secrets/), so
  # a feature that resolves secrets through sekreto can apply here.
  provides: { sekreto: true, schema: true }

  # Files earlier toolchains generated that this target has RETIRED
  # (vendor-tag rollout): the struct-corpus runner (test/Runner.php is
  # support-only and RETAINED). `doctor` reports leftovers; `doctor
  # prune` deletes them.
  superseded: [
    'test/StructRunner.php'
  ]

  deps: &: {
    kind: *'prod' | string
  }

  # struct utility is vendored under tm/php/utility/struct - no manifest dep needed
  deps: {}
}


main: kit: feature: &: target: php: deps: &: {
  kind: *'prod' | string
}


main: kit: target: php: publish: {
  registry: {
    name: 'packagist'
    url: 'https://packagist.org'
    vault: { alias: 'packagist', env: 'PACKAGIST_API_TOKEN' }
  }
}
