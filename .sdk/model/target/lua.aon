
main: kit: target: lua: {

  title: Lua
  ext: lua
  comment: line: "--"
  module: name: 'playstation-store-api2'
  base: 'node_modules/@voxgig/sdkgen/project/.sdk'
  package: '@voxgig/sdkgen'
  srcfeature: false

  # Applicability (docs/design/feature-tags.md). A vendored sekreto port
  # lives in this target's feature container (tm/lua/feature/secrets/), so
  # a feature that resolves secrets through sekreto can apply here.
  #
  # What lua ships: the four built-in kinds (env, memory, dotenv, file) in
  # the vendored core, and every plugin kind as a trimmable group. The
  # plugin kinds reach `sekreto.plugins.net`, which runs a small COMPILED
  # helper (feature/secrets/native/sekretonet.c, -lssl -lcrypto) because
  # Lua 5.4 has no sockets and no TLS. The helper is vendored with the
  # feature and built by the generated Makefile ONLY when a plugin group is
  # active (Main_lua emits feature/secrets/native.mk then), so an SDK
  # without secrets - or with the built-in chain alone - runs no compiler
  # and links no OpenSSL. `sekreto.plugins.net` finds the binary through
  # its own adapted helperpath() (vendor/routes.json), at
  # feature/secrets/native/sekreto-net.
  provides: { sekreto: true, schema: true }

  # Files earlier toolchains generated that this target has RETIRED
  # (vendor-tag rollout): the struct-corpus runner (test/runner.lua is
  # support-only and RETAINED). `doctor` reports leftovers; `doctor
  # prune` deletes them.
  superseded: [
    'test/struct_runner.lua'
  ]

  deps: &: {
    kind: *'prod' | string
  }

  # struct utility is vendored under tm/lua/utility/struct - no manifest dep needed
  deps: {
    'dkjson': { active: true, version: '2.5' }
  }
}


main: kit: feature: &: target: lua: deps: &: {
  kind: *'prod' | string
}


# Publication: luarocks registry (declared, publish pending — git-tag only).
#
# `target add <t>` OVERWRITES this file, so a project must never set its
# publication values here — voxgig-solardemo-sdk lost its pinned npm package
# name exactly that way. Set them in the project's own overlay
# (`model/project.aon`), which create-sdkgen creates once and never
# overwrites — NOT `model/sdk.aon`, which it rewrites on every scaffold.
#
# For that to work this file must LEAVE THOSE KEYS UNSET: in aontu a concrete
# value does not yield to another concrete value, it CONFLICTS, and two
# defaults conflict too. The schema (@voxgig/sdkgen/model/sdkgen.aon)
# already defaults `tag.active`, `registry.state`, `registry.active` and
# `registry.package`, so a project's concrete value wins over the default and
# repeating them here would only take that away.
#
# What remains below is per-target registry IDENTITY, which is not a project
# choice and stays concrete.
main: kit: target: lua: publish: {
  registry: {
    name: 'luarocks'
    url: 'https://luarocks.org'
    vault: { alias: 'luarocks', env: 'LUAROCKS_API_KEY' }
  }
}
