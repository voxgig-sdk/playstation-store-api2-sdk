
main: kit: target: go: {

  title: Golang
  ext: go
  comment: line: "//"
  module: name: 'playstation-store-api2'
  base: 'node_modules/@voxgig/sdkgen/project/.sdk'
  package: '@voxgig/sdkgen'
  srcfeature: false

  # Applicability (docs/design/feature-tags.md). A vendored sekreto port
  # lives in this target's feature container (tm/go/feature/secrets/), so
  # a feature that resolves secrets through sekreto can apply here.
  provides: { sekreto: true, schema: true }

  superseded: [
    'test/runner_test.go'
    'test/struct_runner_test.go'
  ]

  deps: &: {
    kind: *'prod' | string
  }

  deps: {}
}


main: kit: feature: &: target: go: deps: &: {
  kind: *'prod' | string
}




# Feature source may be trimmed to the model's selection. The one template
# needing the COMPLETE set is the cross-feature test suite, which
# constructs every feature.New*Feature — so it is dropped alongside the
# features it exercises whenever the set is trimmed.
main: kit: target: go: feature: {
  trim: true
  fullset: ['test/feature_test.go']
}
