
main: kit: target: py: {

  title: Python
  ext: py
  comment: line: "#"
  module: name: 'playstation-store-api2'
  base: 'node_modules/@voxgig/sdkgen/project/.sdk'
  package: '@voxgig/sdkgen'
  srcfeature: false

  # Applicability (docs/design/feature-tags.md). A vendored sekreto port
  # lives in this target's feature container (tm/py/pkg/feature/secrets/),
  # so a feature that resolves secrets through sekreto can apply here.
  provides: { sekreto: true, schema: true }

  # Files earlier toolchains generated that this target has RETIRED
  # (vendor-tag rollout): the struct-corpus runner (test/runner.py is
  # support-only and RETAINED). `doctor` reports leftovers; `doctor
  # prune` deletes them.
  superseded: [
    'test/struct_runner.py'
  ]

  deps: &: {
    kind: *'prod' | string
  }

  # struct utility is vendored under tm/py/utility/voxgig_struct - no manifest dep needed
  deps: {
    'requests': { active: true, version: '2.33' }
  }
}


main: kit: feature: &: target: py: deps: &: {
  kind: *'prod' | string
}


main: kit: target: py: publish: {
  registry: {
    name: 'pypi'
    url: 'https://pypi.org'
    vault: { recipe: 'pypi', alias: 'pypi' }
  }
}
