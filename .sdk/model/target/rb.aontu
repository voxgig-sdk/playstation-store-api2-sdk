
main: kit: target: rb: {

  title: Ruby
  ext: rb
  comment: line: "#"
  module: name: 'playstation-store-api2'
  base: 'node_modules/@voxgig/sdkgen/project/.sdk'
  package: '@voxgig/sdkgen'
  srcfeature: false

  # Applicability (docs/design/feature-tags.md). A vendored sekreto port
  # lives in this target's feature container (tm/rb/feature/secrets/), so
  # a feature that resolves secrets through sekreto can apply here.
  provides: { sekreto: true, schema: true }

  # Files earlier toolchains generated that this target has RETIRED
  # (vendor-tag rollout): the struct-corpus runner (test/runner.rb is
  # support-only and RETAINED). `doctor` reports leftovers; `doctor
  # prune` deletes them.
  superseded: [
    'test/struct_runner.rb'
  ]

  deps: &: {
    kind: *'prod' | string
  }

  deps: {
    'json': { active: true }
  }
}


main: kit: feature: &: target: rb: deps: &: {
  kind: *'prod' | string
}


main: kit: target: rb: publish: {
  registry: {
    name: 'rubygems'
    url: 'https://rubygems.org'
    vault: { recipe: 'gem', alias: 'gem' }
  }
}
